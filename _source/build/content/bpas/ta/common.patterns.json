[
  {
    "pattern": "^(\\d+) unanswered$",
    "replacement": "$1 விடையளிக்கப்படவில்லை"
  },
  {
    "pattern": "^(\\d+) / (\\d+) sections understood$",
    "replacement": "$1 / $2 பகுதிகள் புரிந்துகொள்ளப்பட்டன"
  },
  {
    "pattern": "^Week (\\d+)$",
    "replacement": "வாரம் $1"
  },
  {
    "pattern": "^(\\d+) days ago$",
    "replacement": "$1 நாட்களுக்கு முன்"
  },
  {
    "pattern": "^\\((\\d+) of (\\d+)\\)$",
    "replacement": "($2இல் $1)"
  },
  {
    "pattern": "^\\((\\d+) attempts?\\)$",
    "replacement": "($1 முயற்சிகள்)"
  },
  {
    "pattern": "^(\\d+) videos? · (\\d+) min$",
    "replacement": "$1 காணொளிகள் · $2 நிமிடம்"
  },
  {
    "pattern": "^Quiz: not tried \\((\\d+) Qs\\)$",
    "replacement": "வினாடிவினா: முயலவில்லை ($1 கேள்விகள்)"
  },
  {
    "pattern": "^Best (\\d+)% · last (\\d+)%$",
    "replacement": "சிறந்தது $1% · கடைசி $2%"
  },
  {
    "pattern": "^(\\d+) questions on this week\\. Answer them all, then press$",
    "replacement": "இந்த வாரத்தில் $1 கேள்விகள். அனைத்துக்கும் விடையளித்துவிட்டுப் பின்னர் அழுத்துங்கள்:"
  },
  {
    "pattern": "^\\. Your best and latest scores are saved and shown on the subject page\\.$",
    "replacement": ". உங்கள் சிறந்த மற்றும் சமீபத்திய மதிப்பெண்கள் சேமிக்கப்பட்டுப் பாடப் பக்கத்தில் காட்டப்படும்."
  },
  {
    "pattern": "^Human Computer Interaction · Week (\\d+)$",
    "replacement": "மனித–கணினி இடைவினை · வாரம் $1"
  },
  {
    "pattern": "^Business Processes & Accounting Systems · Week (\\d+)$",
    "replacement": "வணிகச் செயல்முறைகளும் கணக்கியல் முறைமைகளும் · வாரம் $1"
  }
]
